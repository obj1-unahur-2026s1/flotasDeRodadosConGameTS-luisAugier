import rodados.*
import pedidos.*
describe "test pedidos"{
  const cachito = new ChevroletCorsa( color = rojo )
   pedidos.puedeSatisfacerUnPedido(cachito)

  test "El peso total de flota de deportes es 6450" {
    assert.equals(1300 * 3 + 1350 + 1200, deportes.pesoTotal())
  }

}


